# Use a conexão Session Pooler do projeto EXISTENTE (Supabase > Connect).
# sslmode=require exige conexão TLS. Codifique caracteres especiais da senha na URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require"

# Gerar uma chave longa e aleatória. Não enviar ao GitHub nem ao frontend.
ADMIN_ACCESS_KEY="COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_LONGA"

# Somente no backend; bucket contos-pdf permanece privado.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="COLOQUE_AQUI_SUA_CHAVE_PRIVADA_DO_SUPABASE"

# Render fornece PORT automaticamente; 3000 no ambiente local.
PORT=3000
NODE_ENV=development
# Opcional: false desativa temporariamente o importador; true é o padrão.
ESP_IMPORTACAO_AUTOMATICA=true
